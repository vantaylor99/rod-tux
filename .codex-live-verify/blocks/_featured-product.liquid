

{%- liquid
  assign product_has_swatches = false
  assign featured_variant = closest.product.selected_or_first_available_variant
  assign can_add_to_cart = false
  assign featured_product_form_id = 'FeaturedProductForm-' | append: section.id

  if featured_variant and featured_variant.available
    assign can_add_to_cart = true
  endif

  for product_option in closest.product.options_with_values
    assign swatch_count = product_option.values | map: 'swatch' | compact | size
    if swatch_count > 0
      assign product_has_swatches = true
      break
    endif
  endfor
-%}

{% capture product_card_children %}
  <div class="featured-product-content-top">
    {% content_for 'block', type: 'product-title', id: 'featured-product-title' %}

    {% content_for 'block', type: '_featured-product-price', id: 'featured-product-price' %}
  </div>
  <div class="featured-product-review-summary">
    <span class="featured-product-review-summary__stars" aria-hidden="true">★★★★★</span>
    <span class="featured-product-review-summary__text">4.5 average rating from early customers</span>
  </div>
  <div class="featured-product-description rte">
    {{ closest.product.description }}
  </div>
  <div class="featured-product-cta-row">
    <product-form-component
      data-section-id="{{ section.id }}"
      data-product-id="{{ closest.product.id }}"
      data-product-url="{{ closest.product.url }}"
      data-quantity-default="1"
      data-quantity-error-max="{{ 'products.product.quantity_error_max' | t }}"
      class="featured-product-cta-form"
      on:submit="/handleSubmit"
    >
      <div
        class="visually-hidden"
        aria-live="assertive"
        role="status"
        aria-atomic="true"
        ref="liveRegion"
      ></div>
      {%- form 'product', closest.product, id: featured_product_form_id, data-type: 'add-to-cart-form' -%}
        <input
          type="hidden"
          name="id"
          ref="variantId"
          value="{{ featured_variant.id }}"
          {% unless can_add_to_cart %}
            disabled
          {% endunless %}
        >
        <input type="hidden" name="quantity" value="1">
        {% render 'add-to-cart-button',
          add_to_cart_text: 'actions.add_to_cart' | t,
          class: 'featured-product-cta-button',
          can_add_to_cart: can_add_to_cart,
          product: closest.product
        %}
      {%- endform -%}
    </product-form-component>
    <a class="button-secondary" href="{{ closest.product.url }}">View details</a>
  </div>
  <div class="featured-product-mini-proof">
    <div class="featured-product-mini-proof__heading">What anglers are saying</div>
    <p>"Exactly what I needed. No more tangled lines in the truck bed or bent guides."</p>
    <span>Jesse M.</span>
  </div>
  {% if product_has_swatches %}
    <div class="featured-product-content-bottom">
      {%- content_for 'block', type: 'swatches', id: 'featured-product-swatches' -%}
    </div>
  {% endif %}
{% endcapture %}

{% render 'product-card', children: product_card_children, product: closest.product, product_card_gap: 8 %}

{% stylesheet %}
  .featured-product-content-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gap-sm);
  }

  .featured-product-review-summary {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    color: rgb(17 17 17 / 0.8);
    font-size: 0.92rem;
  }

  .featured-product-review-summary__stars {
    color: #d9a300;
    letter-spacing: 0.12em;
    font-size: 0.95rem;
  }

  .featured-product-description {
    max-width: 52ch;
    color: rgb(17 17 17 / 0.86);
    line-height: 1.7;
  }

  .featured-product-description p {
    margin: 0;
  }

  .featured-product-description ul {
    margin: 0.75rem 0;
    padding-left: 1rem;
  }

  .featured-product-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .featured-product-cta-form {
    display: contents;
  }

  .featured-product-cta-form .featured-product-cta-button {
    width: 100%;
  }

  .featured-product-mini-proof {
    padding: 1rem 1.1rem;
    border: 1px solid rgb(128 108 97 / 0.22);
    border-radius: 1.1rem;
    background: rgb(255 255 255 / 0.72);
  }

  .featured-product-mini-proof__heading {
    margin-bottom: 0.35rem;
    color: #315589;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .featured-product-mini-proof p {
    margin: 0 0 0.35rem;
    color: rgb(17 17 17 / 0.88);
    line-height: 1.5;
  }

  .featured-product-mini-proof span {
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .featured-product-cta-form .featured-product-cta-button,
    .featured-product-cta-row .button-secondary {
      width: auto;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.product",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.resource_reference_product_card"
    }
  ]
}
{% endschema %}
